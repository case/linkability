#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Default to the whole repo so bin/lint, CI, and any hook agree on scope.
if [ "$#" -eq 0 ]; then
  set -- .
fi

# Required, not skipped-if-absent: a check that cannot fail is worse than no
# check. mise.toml pins both; `mise install` provides them.
for tool in shellcheck actionlint; do
  if ! command -v "$tool" > /dev/null; then
    echo "bin/lint: $tool not found; run mise install" >&2
    exit 1
  fi
done

# Run every linter even if an earlier one fails, so one pass shows all findings.
exit_code=0
uv run ruff check "$@" || exit_code=$?
uv run ruff format --check "$@" || exit_code=$?
uv run pyright "$@" || exit_code=$?

# Found by shebang, and always the whole of bin/ whatever paths were passed.
# Why: Docs/ci-signing.md
shell_scripts=()
while IFS= read -r script; do
  shell_scripts+=("$script")
done < <(find bin -type f -exec grep -lE '^#!.*(bash|[^a-z]sh)$' {} +)
# The CI scripts run only on a runner, so a shebang this pattern misses would
# drop one out of the lint pass with nothing to notice it.
missing=()
for candidate in bin/ci-*; do
  [ -f "$candidate" ] || continue
  printf '%s\n' "${shell_scripts[@]}" | grep -qxF "$candidate" || missing+=("$candidate")
done
if [ "${#missing[@]}" -gt 0 ]; then
  printf 'bin/lint: CI scripts not reached by the shell pass: %s\n' "${missing[*]}" >&2
  exit_code=1
fi
shellcheck "${shell_scripts[@]}" || exit_code=$?

# The signing layer lives as much in the workflow YAML as in bin/, so the
# workflows are gated too rather than checked by hand.
workflows=()
while IFS= read -r workflow; do
  workflows+=("$workflow")
done < <(find .github/workflows -type f -name '*.yml')
if [ "${#workflows[@]}" -eq 0 ]; then
  echo "bin/lint: no workflows found; the actionlint pass is inert" >&2
  exit_code=1
else
  actionlint "${workflows[@]}" || exit_code=$?
fi

exit $exit_code
